# おやごころ backend 環境変数サンプル
# 実環境変数は .env にコピーしてから値を埋める（.env は .gitignore 対象）

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oyagokoro

# ===== Firebase Auth =====
# 開発: Service Account JSON ファイルパス参照を推奨（FIREBASE_CREDENTIALS_FILE）
# 本番（Vercel 等）: 環境変数3変数式を使用（FIREBASE_PROJECT_ID + FIREBASE_PRIVATE_KEY + FIREBASE_CLIENT_EMAIL）
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# 開発容易性のためのモック認証フラグ。APP_ENV=production 時は強制無効化される（多重防御）
USE_AUTH_MOCK=false

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Resend (メール配信) =====
RESEND_API_KEY=

# ===== AWS S3 (写真・音声) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-1

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== Application =====
APP_ENV=local
LOG_LEVEL=INFO
